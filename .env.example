# --- Telegram ---
# Token from @BotFather. Never share or commit it.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids allowed to control the bot (send /myid to the bot to find yours)
ALLOWED_CHAT_IDS=

# --- Mode: paper (simulated money, default) or live (REAL MONEY) ---
TRADING_MODE=paper
# Live mode only: must be exactly I_ACCEPT_THE_RISK
LIVE_CONFIRM=
# Live mode with LEVERAGE > 1 only: must be exactly I_UNDERSTAND_LIQUIDATION
LIVE_LEVERAGE_CONFIRM=

# --- Market ---
# futures = leverage + long/short, spot = long only, no leverage
MARKET_TYPE=futures
# binanceusdm, bybit, okx ... (use one that works in your country). "binance" is mapped to binanceusdm for futures.
EXCHANGE=binanceusdm
# Live only. Create the key WITHOUT withdrawal permission, ideally IP-restricted.
API_KEY=
API_SECRET=
SYMBOL=BTC/USDT
TIMEFRAME=5m

# --- Strategy: ensemble, ema_trend, supertrend, macd_trend, bb_reversion, breakout, sma_rsi ---
STRATEGY=ensemble
# sma_rsi only
FAST_SMA=10
SLOW_SMA=30
RSI_PERIOD=14
RSI_MAX_BUY=70

# --- Leverage & risk ---
LEVERAGE=3
# Hard cap: /leverage and LEVERAGE can never exceed this (max 25)
MAX_LEVERAGE=10
# % of equity lost if the stop-loss is hit. Position size is derived from it. 0 = fixed TRADE_SIZE_QUOTE margin
RISK_PER_TRADE_PCT=1
TRADE_SIZE_QUOTE=50
# Max % of equity used as margin in a single trade
MAX_MARGIN_PCT=50
# Stop / target = multiple of ATR (volatility). 0 = use the fixed percentages below
SL_ATR_MULT=1.5
TP_ATR_MULT=3
# Stop-loss never tighter than this % of price (fees would eat it)
MIN_STOP_PCT=0.2
# Caps for ATR stops (or the fixed values when the multipliers are 0)
STOP_LOSS_PCT=1.5
TAKE_PROFIT_PCT=3
# Halt trading for the day (and close) if equity falls this much from the day's start
DAILY_LOSS_LIMIT_PCT=5
MAX_DAILY_TRADES=20
# Simulation costs (paper + backtest)
FEE_RATE=0.0005
SLIPPAGE_PCT=0.02
PAPER_START_BALANCE=1000
POLL_SECONDS=30
