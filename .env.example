# --- Telegram ---
# from @BotFather
TELEGRAM_BOT_TOKEN=
# comma-separated; send /myid to the bot to find yours
ALLOWED_CHAT_IDS=

# --- Mode: paper (simulated, default) or live (REAL MONEY) ---
TRADING_MODE=paper
# must be exactly "I_ACCEPT_THE_RISK" for live mode
LIVE_CONFIRM=

# --- Exchange (crypto, via ccxt) ---
EXCHANGE=binance
# live only; create a key WITHOUT withdrawal permission
API_KEY=
API_SECRET=
SYMBOL=BTC/USDT
TIMEFRAME=1h

# --- Strategy: SMA crossover + RSI filter ---
FAST_SMA=10
SLOW_SMA=30
RSI_PERIOD=14
RSI_MAX_BUY=70

# --- Risk ---
# amount of quote currency (USDT) per entry
TRADE_SIZE_QUOTE=50
STOP_LOSS_PCT=3
TAKE_PROFIT_PCT=6
# halts trading for the day if equity falls this much
DAILY_LOSS_LIMIT_PCT=5
PAPER_START_BALANCE=1000
POLL_SECONDS=30
